{
  "name": "voice-math-tutor-pc",
  "productName": "VoiceMathTutor",
  "version": "0.1.0",
  "description": "Screen-aware voice Socratic math tutor for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "pdfjs-dist": "4.7.76",
    "katex": "^0.16.11"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "@electron/packager": "^18.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.tynan.mathlificient.pc",
    "productName": "VoiceMathTutor",
    "directories": { "output": "dist" },
    "files": ["**/*", "!dist/**"],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
