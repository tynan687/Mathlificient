<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- The standalone study bubble: an overlay shelf for the offline tools. It
         records nothing and captures nothing, so none of the typed categories
         above describe it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".TutorApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceMathTutor">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".FormulaSheetActivity"
            android:exported="true"
            android:label="Formula Sheet" />

        <activity
            android:name=".TimerActivity"
            android:exported="true"
            android:label="Focus Timer" />

        <activity
            android:name=".PracticeActivity"
            android:exported="true"
            android:label="Practice"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar" />

        <activity
            android:name=".PracticeSpaceActivity"
            android:exported="true"
            android:label="Practice Studio"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <service
            android:name=".timer.AmbientService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.tynan.mathtutor.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".service.RealtimeService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaProjection" />

        <!-- Bubble without a tutoring session. Must NOT use microphone or
             mediaProjection types: on API 34+ startForeground throws
             SecurityException with those unless the permission/projection token
             is held, and this service deliberately holds neither. -->
        <service
            android:name=".service.BubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a draggable shortcut bubble on screen so the
                    offline formula sheet, focus timer and practice questions stay
                    reachable while the student works in another app." />
        </service>
    </application>
</manifest>
